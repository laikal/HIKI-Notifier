<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Exe</OutputType><AssemblyName>HIKI Kick Checks</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget><LangVersion>7.3</LangVersion>
    <OutputPath>bin/$(Configuration)/</OutputPath><Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Net.Http"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/>
    <Compile Include="KickChecks.cs"/><None Include="App.config"/>
    <ProjectReference Include="../HIKI.Provider.Kick.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="../../../Contracts/HIKI.Notifier.Contracts.csproj"/>
    <ProjectReference Include="../../../Version/HIKI.Notifier.Version.csproj"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets"/>
  <Target Name="CopyExistingHost" AfterTargets="Build">
    <ItemGroup><HostFiles Include="../../../bin/Modular/Release/**/*"/></ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="../bin/$(Configuration)/HIKI.Provider.Kick.dll" DestinationFolder="$(OutputPath)Providers"/>
  </Target>
</Project>
